# Copie para .env (local) ou cadastre no painel da Vercel. Nunca versione valores reais.

# Postgres de produção (Neon/Supabase). Sem ela, usa SQLite local (easygroove.db).
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Chave de assinatura do login. Gere com: python -c "import secrets;print(secrets.token_urlsafe(48))"
EASYGROOVE_SECRET_KEY=

# "production" ativa cookie Secure, cache longo dos estáticos e exige a chave acima
EASYGROOVE_ENV=production

# Recuperação de senha por e-mail (SMTP). Sem isso, "esqueci minha senha" não envia nada.
# Gmail: ative a verificação em duas etapas e crie uma "senha de app" em myaccount.google.com/apppasswords
EASYGROOVE_SMTP_USER=contato.easygroove@gmail.com
EASYGROOVE_SMTP_PASSWORD=
# Endereço público do site (usado no link do e-mail), sem barra no final
EASYGROOVE_BASE_URL=https://seu-projeto.vercel.app
# Opcionais: EASYGROOVE_SMTP_HOST (padrão smtp.gmail.com) e EASYGROOVE_SMTP_PORT (padrão 587)
