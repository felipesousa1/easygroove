# Copie para .env (local) ou cadastre no painel da Vercel. Nunca versione valores reais.

# Postgres de produção (Neon/Supabase). Sem ela, usa SQLite local (easygroove.db).
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Chave de assinatura do login. Gere com: python -c "import secrets;print(secrets.token_urlsafe(48))"
EASYGROOVE_SECRET_KEY=

# "production" ativa cookie Secure, cache longo dos estáticos e exige a chave acima
EASYGROOVE_ENV=production
